+/* ---- TLS diagnostics instrumentation (TLSDIAG5): logs only, no behavior change.
+   The PS4 has no reliable stdio for libraries: diagnostics go through a hook that
+   the application overrides (it logs via its own working logger). If the app does
+   not define the hook, the default weak stub does nothing. Verification untouched. */
+void __attribute__((weak)) ps4_diag_line(const char *fmt, ...) { (void)fmt; }
+static void
+mbed_diag_write(const char *fmt, ...)
+{
+  va_list ap;
+  char line[1024];
+  va_start(ap, fmt);
+  vsnprintf(line, sizeof(line), fmt, ap);
+  va_end(ap);
+  ps4_diag_line("%s", line);
+}
+
+static void
+mbed_diag_flag_names(uint32_t flags, char *buf, size_t len)
+{
+  static const struct { uint32_t bit; const char *name; } fl[] = {
+    { MBEDTLS_X509_BADCERT_EXPIRED, "EXPIRED" },
+    { MBEDTLS_X509_BADCERT_REVOKED, "REVOKED" },
+    { MBEDTLS_X509_BADCERT_CN_MISMATCH, "CN_MISMATCH" },
+    { MBEDTLS_X509_BADCERT_NOT_TRUSTED, "NOT_TRUSTED" },
+    { MBEDTLS_X509_BADCRL_NOT_TRUSTED, "CRL_NOT_TRUSTED" },
+    { MBEDTLS_X509_BADCRL_EXPIRED, "CRL_EXPIRED" },
+    { MBEDTLS_X509_BADCERT_MISSING, "MISSING" },
+    { MBEDTLS_X509_BADCERT_SKIP_VERIFY, "SKIP_VERIFY" },
+    { MBEDTLS_X509_BADCERT_OTHER, "OTHER" },
+    { MBEDTLS_X509_BADCERT_FUTURE, "FUTURE" },
+    { MBEDTLS_X509_BADCRL_FUTURE, "CRL_FUTURE" },
+    { MBEDTLS_X509_BADCERT_KEY_USAGE, "KEY_USAGE" },
+    { MBEDTLS_X509_BADCERT_EXT_KEY_USAGE, "EXT_KEY_USAGE" },
+    { MBEDTLS_X509_BADCERT_NS_CERT_TYPE, "NS_CERT_TYPE" },
+    { MBEDTLS_X509_BADCERT_BAD_MD, "BAD_MD" },
+    { MBEDTLS_X509_BADCERT_BAD_PK, "BAD_PK" },
+    { MBEDTLS_X509_BADCERT_BAD_KEY, "BAD_KEY" },
+  };
+  size_t i;
+  buf[0] = '\0';
+  for(i = 0; i < sizeof(fl) / sizeof(fl[0]); ++i) {
+    if(flags & fl[i].bit) {
+      if(buf[0])
+        strcat(buf, "|");
+      strcat(buf, fl[i].name);
+    }
+  }
+}
+
+static void
+mbed_diag_log_verify(struct connectdata *conn, int sockindex)
+{
+  struct ssl_connect_data *connssl = &conn->ssl[sockindex];
+  struct ssl_backend_data *backend = connssl->backend;
+  char flagnames[256];
+  uint32_t ret;
+
+  ret = mbedtls_ssl_get_verify_result(&backend->ssl);
+  mbed_diag_flag_names(ret, flagnames, sizeof(flagnames));
+  mbed_diag_write("TLS-DIAG5 host=%s verify_result=0x%08x [%s]",
+                  SSL_HOST_NAME(), (unsigned int) ret,
+                  flagnames[0] ? flagnames : "none");
+}
+/* ---- end TLS diagnostics instrumentation ---- */
